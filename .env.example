DATABASE_URL="postgresql://workstack:workstack@127.0.0.1:5432/workstack?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
JWT_SECRET="replace-with-64-hex-chars: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
REALTIME_PORT=4000

# AI features (optional). Without a key the AI buttons are hidden and AI routes answer 503.
# Free key: https://aistudio.google.com → Get API key
GEMINI_API_KEY=""
AI_MODEL="gemini-flash-lite-latest"
# Tried in order when the main model is retired, rate limited or overloaded.
AI_FALLBACK_MODELS="gemini-flash-latest"
AI_USER_HOURLY_LIMIT=20
AI_DAILY_TOKEN_BUDGET=200000
