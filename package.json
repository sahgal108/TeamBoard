{
  "name": "teamboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:realtime": "tsx watch realtime/server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "sequelize-cli db:migrate",
    "db:reset": "node scripts/reset-db.mjs",
    "db:seed": "tsx db/seed.ts",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "antd": "^6.6.7",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "sequelize-cli": "^6.6.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Multi-tenant project and team management platform",
  "engines": {
    "node": ">=22.12.0"
  }
}
